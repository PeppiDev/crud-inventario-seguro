# Copiar a .env y completar. .env nunca se sube al repositorio ni a la imagen.
# Generar una clave propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-generada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Laboratorio local por HTTP: False. Producción con HTTPS: True (o no definirla).
DJANGO_HTTPS=False
